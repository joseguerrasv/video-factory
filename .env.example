# API keys for Video Factory. The easiest way to fill these is /onboard-me (Services step),
# which writes them into .env for you. .env is gitignored; never commit real keys.
# Leave anything you do not use empty.

# Transcription (word-level timestamps). Pick one provider during onboarding.
# ElevenLabs Scribe: most accurate; also voiceover and sound effects. elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Groq Whisper: fast and cheap. console.groq.com/keys
GROQ_API_KEY=
# OpenAI Whisper: fallback. platform.openai.com/api-keys
OPENAI_API_KEY=

# Kie.ai: AI images, B-roll video (Kling, Veo, Seedance) and music (Suno). Paid credits. kie.ai
KIE_API_KEY=

# Pexels: free stock footage and photos. pexels.com/api
PEXELS_API_KEY=
